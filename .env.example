# =====================================
# Flask Configuration
# =====================================

SECRET_KEY=smart_recruitment_secret_key

# =====================================
# MySQL Configuration
# =====================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smart_recruitment
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# =====================================
# Google Authenticator
# =====================================

APP_NAME="Smart Recruitment Automation System"
QR_CODE_FOLDER=static/qrcodes

# =====================================
# Flask Settings
# =====================================

FLASK_ENV=development
FLASK_DEBUG=True

# =====================================
# SMTP Configuration
# =====================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=hr@company.com
SMTP_EMAIL=hr@company.com
SMTP_PASSWORD=your_smtp_password
SMTP_SECURITY=tls

# =====================================
# Admin Configuration
# =====================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
